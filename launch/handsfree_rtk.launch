<!-- 移动端驱动 -->
<launch>
    <arg name="port" default="/dev/HFRobotRTK"/>
    <arg name="baudrate" default="115200"/>
    <arg name="heading_frame_id" default="map"/>
    <arg name="raw_log_dir" default="$(find handsfree_rtk)/logs"/>

    <node name = "handsfree_rtk" pkg = "handsfree_rtk" type = "cpp_driver_um98x" output="screen">
        <param name="port" value="$(arg port)" type="string"/>
        <param name="baudrate" value="$(arg baudrate)" type="int"/>
        <param name="heading_frame_id" value="$(arg heading_frame_id)" type="string"/>
        <param name="raw_log_dir" value="$(arg raw_log_dir)" type="string"/>
    </node>
</launch>
